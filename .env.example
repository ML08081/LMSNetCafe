DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lms_netcafe
DB_USER=root
DB_PASSWORD=123456
# Optional: keep an existing WSL MySQL instance available while this project runs.
WSL_DISTRO=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JWT_SECRET=replace-with-a-long-random-secret
FACE_SERVICE_URL=http://127.0.0.1:9000
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://172.*:*,http://10.*:*
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_BASE_URL=http://127.0.0.1:8080
VITE_PROXY_API_TARGET=http://127.0.0.1:8080
VITE_WS_BASE_URL=ws://127.0.0.1:8080
VITE_LMS_PET_SERVER_URL=http://127.0.0.1:8080
VITE_LMS_PET_DEVICE_CODE=PC-A01

# AI uses a Chat Completions compatible endpoint. Configure locally, then restart backend.
# Disabled mode shows explicitly labeled built-in answers and statistical summaries.
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=12
AI_MAX_OUTPUT_TOKENS=1600
# Use max_tokens if required by the chosen compatible provider.
AI_TOKEN_PARAMETER=max_completion_tokens
