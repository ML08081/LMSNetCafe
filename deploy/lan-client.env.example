# Copy values into .env on the access/client computer when it runs frontend or desktop-pet locally.
# Replace 172.16.60.121 with the host server LAN IP.
VITE_BACKEND_BASE_URL=http://172.16.60.121:8080
VITE_PROXY_API_TARGET=http://172.16.60.121:8080
VITE_API_BASE_URL=http://172.16.60.121:8080/api/v1
VITE_LMS_PET_SERVER_URL=http://172.16.60.121:8080
VITE_LMS_PET_DEVICE_CODE=PC-A02
LMS_PET_SERVER_URL=http://172.16.60.121:8080
LMS_PET_DEVICE_CODE=PC-A02
